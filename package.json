{
  "name": "@keithjgrant/argot",
  "version": "0.0.1",
  "description": "Semantic CSS custom property names, template generation, and Stylelint rules",
  "license": "MIT",
  "author": "Keith J. Grant",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keithjgrant/argot.git"
  },
  "bugs": {
    "url": "https://github.com/keithjgrant/argot/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "bin": {
    "argot": "./bin/argot.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "src",
    "tokens",
    "templates"
  ],
  "exports": {
    "./tokens/*": "./tokens/*",
    "./templates/semantics.css": "./templates/semantics.css",
    "./templates/semantics-extended.css": "./templates/semantics-extended.css",
    "./generate": "./src/generate.js",
    "./stylelint": "./src/stylelint/index.js",
    "./stylelint/config": "./src/stylelint/config.js"
  },
  "scripts": {
    "build:template": "node bin/argot.js generate ./templates/semantics.css && node bin/argot.js generate --extended ./templates/semantics-extended.css",
    "test": "node scripts/test-stylelint.js && node --test scripts/test-modules.js",
    "website:dev": "eleventy --config=website/eleventy.config.js --serve",
    "website:build": "eleventy --config=website/eleventy.config.js",
    "website:test": "node --test website/test/*.test.js",
    "website:format": "prettier --write website --ignore-unknown",
    "website:format:check": "prettier --check website --ignore-unknown"
  },
  "peerDependencies": {
    "stylelint": "^16.0.0"
  },
  "peerDependenciesMeta": {
    "stylelint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "prettier": "^3.10.1",
    "stylelint": "^16.0.0"
  }
}
