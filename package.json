{
  "name": "@keithjgrant/argot",
  "version": "0.0.1",
  "description": "Semantic CSS custom property names, template generation, and Stylelint rules",
  "license": "MIT",
  "author": "Keith J. Grant",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keithjgrant/argot.git"
  },
  "bugs": {
    "url": "https://github.com/keithjgrant/argot/issues"
  },
  "type": "commonjs",
  "bin": {
    "argot": "./bin/argot.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "src",
    "tokens",
    "templates"
  ],
  "exports": {
    "./tokens/*": "./tokens/*",
    "./templates/semantics.css": "./templates/semantics.css",
    "./generate": "./src/generate.js",
    "./stylelint": "./src/stylelint/index.js",
    "./stylelint/config": "./src/stylelint/config.js"
  },
  "scripts": {
    "build:template": "node bin/argot.js generate ./templates/semantics.css",
    "test": "node scripts/test-stylelint.js"
  },
  "peerDependencies": {
    "stylelint": "^15.0.0 || ^16.0.0"
  },
  "peerDependenciesMeta": {
    "stylelint": {
      "optional": true
    }
  },
  "devDependencies": {
    "stylelint": "^16.0.0"
  }
}
