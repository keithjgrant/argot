{
  "name": "@keithjgrant/argot",
  "version": "0.0.1",
  "description": "Semantic design token names and a modern, lightweight CSS toolchain",
  "license": "MIT",
  "author": "Keith J. Grant",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keithjgrant/argot.git"
  },
  "bugs": {
    "url": "https://github.com/keithjgrant/argot/issues"
  },
  "type": "commonjs",
  "bin": {
    "argot": "./bin/argot.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "src",
    "tokens",
    "templates"
  ],
  "exports": {
    "./tokens/*": "./tokens/*",
    "./templates/semantics.css": "./templates/semantics.css",
    "./generate": "./src/generate.js"
  },
  "scripts": {
    "build:template": "node bin/argot.js generate ./templates/semantics.css",
    "test": "node -e \"require('./src/generate').generateCss(); console.log('ok')\""
  }
}
