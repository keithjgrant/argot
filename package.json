{
  "name": "argot-css",
  "version": "0.0.1",
  "description": "Modern, streamlined CSS development kit",
  "license": "MIT",
  "author": "Keith J. Grant",
  "keywords": [
    "css",
    "preprocessor",
    "custom properties",
    "css variables"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keithjgrant/argot.git"
  },
  "bugs": {
    "url": "https://github.com/keithjgrant/argot/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "argot": "./bin/argot.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "dist",
    "docs/api.md",
    "tokens",
    "templates"
  ],
  "exports": {
    "./tokens/*": "./tokens/*",
    "./templates/semantics.css": "./templates/semantics.css",
    "./templates/semantics-extended.css": "./templates/semantics-extended.css",
    "./semantics": {
      "types": "./dist/semantics/generate.d.ts",
      "import": "./dist/semantics/generate.js"
    },
    "./palette": {
      "types": "./dist/palette/index.d.ts",
      "import": "./dist/palette/index.js"
    },
    "./palette/node": {
      "types": "./dist/palette/node.d.ts",
      "import": "./dist/palette/node.js"
    },
    "./stylelint": {
      "types": "./dist/stylelint/index.d.ts",
      "import": "./dist/stylelint/index.js"
    },
    "./stylelint/config": {
      "types": "./dist/stylelint/config.d.ts",
      "import": "./dist/stylelint/config.js"
    },
    "./stylelint-default": {
      "import": "./dist/processor/stylelintDefault.js",
      "types": "./dist/processor/stylelintDefault.d.ts"
    }
  },
  "scripts": {
    "cli": "node scripts/devCli.js",
    "build": "tsc -p tsconfig.build.json",
    "checks": "npm run build && npm run eslint && npm run test",
    "tsc": "tsc --noEmit",
    "test:types": "tsc --project scripts/types/tsconfig.json && tsc --project scripts/types/tsconfig.browser.json",
    "test:package": "node --test scripts/package.test.js",
    "pretest": "npm run build && npm run tsc && npm run test:types",
    "prepack": "npm run build",
    "eslint": "eslint .",
    "prepublishOnly": "npm run checks",
    "preversion": "npm run checks",
    "prettier": "prettier --check . --ignore-unknown",
    "prettier:fix": "prettier --write . --ignore-unknown",
    "build:template": "node scripts/devCli.js semantics ./templates/semantics.css && node scripts/devCli.js semantics --extended ./templates/semantics-extended.css",
    "test": "node --test 'src/**/*.test.ts' 'scripts/**/*.test.js' 'website/**/*.test.js'",
    "website:dev": "eleventy --config=website/eleventy.config.js --serve",
    "prewebsite:build": "npm run website:lint",
    "website:build": "eleventy --config=website/eleventy.config.js",
    "website:test": "node --test website/test/*.test.js",
    "website:lint": "stylelint \"website/content/assets/**/*.css\" --config website/stylelint.config.js --max-warnings=0",
    "website:lint:fix": "npm run website:lint -- --fix",
    "website:format": "prettier --write website --ignore-unknown",
    "website:format:check": "prettier --check website --ignore-unknown"
  },
  "dependencies": {
    "colorjs.io": "0.7.1",
    "cssnano": "^9.9.0",
    "postcss": "^8.5.33",
    "postcss-reporter": "^7.1.0",
    "stylelint": "^18.0.0",
    "stylelint-config-recommended": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "stylelint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@eslint/js": "^10.0.1",
    "@jgarber/eleventy-plugin-postcss": "^3.0.1",
    "@types/node": "^22.20.5",
    "@types/postcss-import": "^14.0.3",
    "@types/postcss-reporter": "^7.0.5",
    "eslint": "^10.15.0",
    "postcss-import": "^17.0.1",
    "prettier": "^3.10.1",
    "stylelint-test-rule-node": "^2.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
