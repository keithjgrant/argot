<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ description or 'An unobtrusive toolset for modern CSS development.' }}">
    <meta name="generator" content="{{ eleventy.generator }}">
    <title>{% if title %}{{ title }} · {% endif %}Argot</title>
    <link rel="stylesheet" href="{{ '/assets/site.css' | url }}">
  </head>
  <body{% if singleColumn %} class="page-single-col"{% endif %}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-frame">
      <header class="page-header">
        <div class="page-header__inner content-container">
          <div class="page-header__brand">
            <a class="wordmark" href="{{ '/' | url }}">Argot</a>
            <p class="page-header__tagline">Modern CSS toolset</p>
          </div>
          <nav class="page-header__nav" aria-label="Primary">
            <a href="{{ '/docs/' | url }}"{% if page.url == '/docs/' %} aria-current="page"{% elif page.url.indexOf('/docs/') == 0 %} aria-current="true"{% endif %}>Docs</a>
            <a href="https://github.com/keithjgrant/argot" rel="noopener noreferrer">GitHub</a>
          </nav>
        </div>
      </header>
      {{ content | safe }}
      <footer class="page-footer content-container prose">
        <p><i>argot /är′gō/: A specialized vocabulary or set of idioms used by a particular group.</i></p>
        <p>Argot is in active development. Some features are not yet production ready.
          Please <a href="https://github.com/keithjgrant/argot/issues">provide
          feedback, suggestions, or report bugs</a>.</p>
        <p>Created by <a href="https://keithjgrant.com">Keith J. Grant</a></p>
      </footer>
    </div>
    {% if tokenSearch %}<script type="module" src="{{ '/assets/token-search.js' | url }}"></script>{% endif %}
  </body>
</html>
