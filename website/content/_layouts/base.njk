<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ description or 'A shared vocabulary for semantic CSS custom properties. Your design, with names that mean something.' }}">
    <meta name="generator" content="{{ eleventy.generator }}">
    <title>{{ title }} · Argot</title>
    <link rel="stylesheet" href="{{ '/assets/site.css' | url }}">
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="{{ '/' | url }}">Argot</a>
      <p class="site-header__tagline">Semantic design tokens for CSS</p>
      <nav aria-label="Primary">
        <a href="{{ '/getting-started/' | url }}"{% if page.url == '/getting-started/' %} aria-current="page"{% endif %}>Getting started</a>
        <a href="{{ '/tokens/' | url }}"{% if page.url == '/tokens/' %} aria-current="page"{% elif section %} aria-current="true"{% endif %}>Token reference</a>
        <a href="https://github.com/keithjgrant/argot">GitHub</a>
      </nav>
    </header>
    <div class="site-body{% if referenceLayout %} site-body__two-column{% endif %}">
      {% if referenceLayout %}
      <nav class="sidebar" aria-label="Token groups">
        <a href="{{ '/tokens/' | url }}"{% if page.url == '/tokens/' %} aria-current="page"{% endif %}>All tokens</a>
        <ul>
          {% for group in reference.sections %}
          <li><a href="{{ group.url | url }}"{% if page.url == group.url %} aria-current="page"{% endif %}>{{ group.title }} <span>{{ group.tokens.length }}</span></a></li>
          {% endfor %}
        </ul>
      </nav>
      {% endif %}
      <main id="main" class="{% if prose != false %}prose{% endif %}">{{ content | safe }}</main>
    </div>
    <footer class="site-footer prose">
      <p>Argot is in beta. <a href="https://github.com/keithjgrant/argot/issues">Share feedback from your projects.</a></p>
      <p>Created by <a href="https://keithjgrant.com">Keith J. Grant</a></p>
    </footer>
    {% if tokenSearch %}<script type="module" src="{{ '/assets/token-search.js' | url }}"></script>{% endif %}
  </body>
</html>
