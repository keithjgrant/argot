---
layout: base.njk
---
<div class="site-body site-body--docs">
  {% include "docs-nav.njk" %}
  <main id="main" class="{% if prose != false %}prose{% endif %}">
    <nav class="token-group-nav" aria-label="Token groups">
      <p>Token groups</p>
      <ul>
        <li><a href="{{ '/docs/tokens/' | url }}"{% if page.url == '/docs/tokens/' %} aria-current="page"{% endif %}>All tokens</a></li>
        {% for group in reference.sections %}
        <li><a href="{{ group.href | url }}"{% if page.url == group.href %} aria-current="page"{% endif %}>{{ group.title }} <span>{{ group.tokens.length }}</span></a></li>
        {% endfor %}
      </ul>
    </nav>
    {{ content | safe }}
  </main>
</div>
